     "id": "a",
     "label": "a",
     "question": "Tính BP, BC.",
     "explanation": "AP là đường phân giác của $\\Delta $ABC\n$\\Rightarrow \\frac{AB}{AC}=\\frac{PB}{PC}$\n$\\Rightarrow \\frac{4}{8}=\\frac{BP}{6}$\n$\\Rightarrow BP=\\frac{4.6}{8}=3$ (cm)\nVậy $BC=BP+PC=3+6=9$ (cm).",
     "points": 1,
     "type": "form_mau",
     "mau_spec": {
      "mau": "khac",
      "kieu": "dong",
      "dong": [
       "$BP =$ {{1}} cm ; $BC =$ {{2}} cm"
      ],
      "o": [
       {
        "id": "1",
        "loai": "so",
        "dap_an": "3"
       },
