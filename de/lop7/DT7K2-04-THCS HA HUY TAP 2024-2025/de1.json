        ],
        "hint": "Chứng minh hai góc bằng nhau"
       },
       {
        "lines": [
         "Do đó $\\triangle AMI$ cân tại {{6}} (có hai góc đáy bằng nhau).",
         "Suy ra $MI =$ {{7}} (tính chất tam giác cân)."
        ],
        "hint": "Chứng minh tam giác cân"
       },
       {
