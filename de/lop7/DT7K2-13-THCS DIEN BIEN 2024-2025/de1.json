        ],
        "hint": "Suy ra trọng tâm"
       },
       {
        "lines": [
         "Vì ${{13}}$ là trung điểm của ${{14}}$ nên ${{15}} = \\frac{1}{2}{{16}}$."
        ],
        "hint": "Liên hệ trung điểm"
       },
       {
        "lines": [
         "Do đó ${{17}} = \\frac{1}{3}{{18}}$, suy ra ${{19}} = 3{{20}}$."
        ],
