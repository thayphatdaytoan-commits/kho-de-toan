{"de2.P1.C1": {"ly_do": "Định lí: có đạo hàm tại x0 thì liên tục tại x0; A, B chỉ cho liên tục một phía, C sai điểm. Đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C10": {"ly_do": "y'=9x²+x-2; y'(-2)=36-2-2=32, đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C11": {"ly_do": "v=S'=gt; v(4)=39,2 m/s, đúng C.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C2": {"ly_do": "y'=3-8x; y'(0)=3, y(0)=0 → tiếp tuyến y=3x, đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C3": {"ly_do": "y'=2x+1; y'(1)=3, đúng A.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C4": {"ly_do": "f'(x)=2x/((x²+1)ln2); f'(1)=1/ln2, đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C5": {"ly_do": "y'=3x²-2; y'(1)=1, đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C6": {"ly_do": "y'=2cos2x+6sin3x·cos3x=2cos2x+3sin6x, đúng A.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C7": {"ly_do": "y'=2/((2x-1)ln2024), đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C9": {"ly_do": "y'=2x; y'(4)=8, đúng C.", "sua_boi": "muse", "xac_nhan": true}, "de2.P3.C1": {"ly_do": "y'=(2x+3)/(2√(x²+3x+2)) → a=2.", "sua_boi": "muse", "xac_nhan": true}, "de2.P3.C3": {"ly_do": "y'=3x²-6x+4; f'(1)=1, y(1)=2 → phương trình tiếp tuyến là y=x+1; short_correct '1' chỉ là hệ số góc, không phải phương trình tiếp tuyến.", "short_correct": "y=x+1", "sua_boi": "muse"}}