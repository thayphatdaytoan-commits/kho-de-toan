{"de1.P1.C1": {"ly_do": "0<log_{1/2}x<3 ⇔ 1/8<x<1, đúng C.", "sua_boi": "muse", "xac_nhan": true}, "de1.P1.C2": {"ly_do": "log3(6+x)+log3(9x)=5 ⇔ x(6+x)=27 ⇔ x=3 (x>0; x=-9 loại), 1 nghiệm, đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de1.P1.C3": {"ly_do": "Cơ số 2/3<1 đổi chiều: x²-3x+2<0 ⇔ 1<x<2 → b-a=1, đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de1.P1.C4": {"ly_do": "3x-2>6-5x và 6-5x>0 ⇔ 1<x<6/5 → S=11/5, đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de1.P1.C5": {"ly_do": "Đặt t=2^x: t²-3t+2<0 ⇔ 1<t<2 ⇔ 0<x<1 → 5a+3b=3, đúng C.", "sua_boi": "muse", "xac_nhan": true}, "de1.P1.C7": {"ly_do": "2x<x+6 ⇔ x<6, đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de1.P1.C8": {"ly_do": "x>1 và x-1>9 ⇔ x>10, đúng A.", "sua_boi": "muse", "xac_nhan": true}, "de1.P3.C6": {"ly_do": "e^(-3t/2)=1/5 → t=(2/3)ln5≈1,07 giờ.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C1": {"ly_do": "(3/4)^(2x-1)≤(3/4)^(2-x), cơ số <1 đổi chiều: 2x-1≥2-x ⇔ x≥1, đúng A.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C10": {"ly_do": "2^x-1=81 → x=log2 82, đúng A.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C3": {"ly_do": "3^(2x+2)=3^(6x+3) ⇔ x=-1/4, đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C4": {"ly_do": "0<x-1<8 ⇔ 1<x<9, đúng A.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C5": {"ly_do": "x>3 và x-3≤1/4 ⇔ 3<x≤13/4, đúng C.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C6": {"ly_do": "ĐK x>0; log3(x²+4x)=log3(2x+3) ⇔ x=1 (x=-3 loại), 1 nghiệm, đúng C.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C7": {"ly_do": "log_{2/5}(x-4)>-1 ⇔ 0<x-4<5/2 ⇔ 4<x<13/2, đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C8": {"ly_do": "6^(x+1)-36^x=5 ⇔ 6^x=1 hoặc 5 ⇔ x=0 hoặc log6 5; tích các nghiệm = 0, đúng B.", "sua_boi": "muse", "xac_nhan": true}, "de2.P1.C9": {"ly_do": "x²-x-6≤0 ⇔ -2≤x≤3; nguyên dương: 1,2,3 → 3 nghiệm, đúng D.", "sua_boi": "muse", "xac_nhan": true}, "de2.P3.C2": {"ly_do": "x>2; 2x-3=3(x-2) ⇔ x=3 (thỏa ĐK).", "sua_boi": "muse", "xac_nhan": true}}