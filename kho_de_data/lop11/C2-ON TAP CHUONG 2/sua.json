{"de1.P3.C1": {"ly_do": "Công thức Binet cho dãy Fibonacci: $u_6=8$.", "sua_boi": "muse", "xac_nhan": true}, "de1.P3.C4": {"ly_do": "Giải $\\frac{2n+1}{n+2}=\\frac{167}{84}$ được $n=250$.", "sua_boi": "muse", "xac_nhan": true}, "de2.P3.C1": {"ly_do": "Truy hồi: $u_3=12$, $u_4=35$, $u_5=111$, $u_6=332$, $u_7=1002$, $u_8=3005$.", "sua_boi": "muse", "xac_nhan": true}}