{"de2.P3.C2": {"ly_do": "Công thức Binet cho dãy Fibonacci: $u_6=8$, khớp short_correct.", "sua_boi": "muse", "xac_nhan": true}, "de2.P3.C3": {"ly_do": "Giải $\\frac{2n+1}{n+2}=\\frac{167}{84}$ được $84(2n+1)=167(n+2)$, suy ra $n=250$.", "sua_boi": "muse", "xac_nhan": true}, "de3.P3.C2": {"ly_do": "Cấp số cộng $u_1=1$, công sai $2$: $u_{50}=1+49\\cdot 2=99$.", "sua_boi": "muse", "xac_nhan": true}}