 "5c": {
  "blocks": [
   {
    "lines": [
     "Gọi $O$ là giao điểm của ${{1}}$ và $BD$.",
     "Vì ${{2}}$ là hình chữ nhật nên $O$ là trung điểm của ${{3}}$."
    ],
    "hint": "Xác định trung điểm đoạn chéo"
   },
   {
    "lines": [
     "Tam giác ${{4}}$ vuông tại $H$ có $HO$ là đường trung tuyến ứng với cạnh huyền ${{5}}$",
     "nên $HO = \\frac{{{{6}}}}{2}$."
    ],
    "hint": "Dùng tính chất trung tuyến tam giác vuông"
   },
   {
    "lines": [
     "Mà $AO = \\frac{{{{7}}}}{2}$ nên ${{8}} = AO$."
    ],
    "hint": "So sánh hai đoạn thẳng bằng nhau"
   },
   {
    "lines": [
     "Lại có $O$ là trung điểm của ${{9}}$ nên $AO = \\frac{{{{10}}}}{2}$.",
     "Do đó $HO = \\frac{{{{11}}}}{2}$, suy ra tam giác ${{12}}$ vuông tại $H$, tức là $HA \\perp HC$."
    ],
    "hint": "Suy ra tam giác vuông tại H"
   },
   {
    "lines": [
     "Vì $H$, $C$, $E$ thẳng hàng nên $HA \\perp {{13}}$.",
     "Mặt khác $ADCE$ là hình bình hành nên $AD$ // ${{14}}$.",
     "Kết hợp với $HA \\perp CE$ suy ra $HA \\perp {{15}}$."
    ],
    "hint": "Chứng minh vuông góc với AD"
   },
   {
    "lines": [
     "Trong tam giác ${{16}}$, ta có $HO = AO = OD$ nên $O$ là tâm đường tròn ngoại tiếp,",
     "suy ra $\\widehat{{{17}}}=90^\\circ$, tức là $HA \\perp HD$."
    ],
    "hint": "Kết luận góc vuông tại H"
   }
  ],
