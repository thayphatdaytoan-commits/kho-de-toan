    "lines": [
     "Gọi {{1}} là {{2}} của cạnh {{3}}."
    ],
    "hint": "Xác định tâm đường tròn ngoại tiếp"
   },
   {
    "lines": [
     "Tam giác $ABC$ vuông tại {{4}} có đường {{5}} bằng nửa cạnh huyền {{6}},",
     "suy ra $IA = IB = IC$ (1)."
    ],
    "hint": "Tính chất tam giác vuông ABC"
   },
   {
    "lines": [
     "Tam giác $MDC$ vuông tại {{7}} (tam giác nội tiếp chắn {{8}} đường tròn đường kính {{9}})",
     "$\\Rightarrow \\triangle BDC$ vuông tại {{10}} $\\Rightarrow IB = IC =$ {{11}} (2)."
    ],
    "hint": "Tính chất tam giác vuông BDC"
   },
   {
    "lines": [
     "Từ (1) và (2) suy ra $IA = IB = IC =$ {{12}}."
    ],
    "hint": "Bắc cầu các đoạn thẳng bằng nhau"
   },
   {
    "lines": [
