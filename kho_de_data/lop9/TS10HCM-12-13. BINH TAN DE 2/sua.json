  "de1.P4.C4": {
    "parts": [
      {
        "id": "a",
        "label": "a",
        "question": "Tính thể tích nước cần đổ vào để nước trong bình cao 50cm. Biết lúc đầu bình không chứa nước.",
        "explanation": "R = 20cm, h = 50cm. V = 3.14 * 20^2 * 50 = 62800 cm3.",
        "points": 0.625,
        "type": "short_answer",
        "shortCorrect": "62800"
      },
      {
        "id": "b",
        "label": "b",
        "question": "Người ta có một số viên bi hình cầu (không thấm nước) có cùng bán kính là 6cm. Có thể thả vào bình nhiều nhất bao nhiêu viên bi để nước trong bình không tràn ra ngoài? Biết các viên bi khi thả vào sẽ chìm xuống đáy bình.",
        "explanation": "Thể tích còn lại của bình là 3.14 * 20^2 * (60-50) = 12560 cm3. Thể tích 1 viên bi là 4/3 * 3.14 * 6^3 = 904.32 cm3. Số bi = 12560 / 904.32 xấp xỉ 13.89. Vậy tối đa 13 viên.",
        "points": 0.625,
        "type": "short_answer",
        "shortCorrect": "13"
      }
    ],
    "sua_boi": "muse",
    "ly_do": "Lời giải mẫu tính đúng 12560/904,32≈13,89 nên tối đa 13 viên, nhưng shortCorrect ghi 18; đã sửa thành 13.",
    "xac_nhan": true
  },
