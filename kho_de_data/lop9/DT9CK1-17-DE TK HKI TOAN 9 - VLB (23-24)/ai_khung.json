   {
    "lines": [
     "Gọi {{1}} là giao điểm của {{2}} và {{3}}.",
     "Chứng minh $\\triangle {{4}}$ vuông tại {{5}} nên {{6}} $\\perp$ {{7}} tại {{5}},",
     "mà {{8}} $\\perp$ {{7}}, suy ra {{6}} // {{8}}."
    ],
    "hint": "Chứng minh hai đường thẳng song song"
   },
   {
    "lines": [
     "Chứng minh {{9}} là trung điểm của {{10}}."
    ],
    "hint": "Chứng minh trung điểm"
   },
   {
    "lines": [
     "Xét $\\triangle {{11}}$ có {{12}} // {{13}} (cùng $\\perp$ {{14}})",
     "nên $\\frac{IC}{MB}=\\frac{DI}{DM}$ (hệ quả Thales) (3)."
    ],
    "hint": "Áp dụng hệ quả Thales"
   },
   {
    "lines": [
     "Xét $\\triangle {{15}}$ có {{16}} // {{17}} (cùng $\\perp$ {{14}})",
     "nên $\\frac{IA}{ME}=\\frac{DI}{DM}$ (hệ quả Thales) (4)."
    ],
    "hint": "Áp dụng hệ quả Thales"
   },
   {
    "lines": [
     "Từ (3) và (4) suy ra $\\frac{IC}{MB}=\\frac{IA}{ME}$,",
     "mà {{18}} = {{19}} ({{9}} là trung điểm {{10}}), do đó {{20}} = {{21}}."
    ],
    "hint": "Suy ra hai đoạn thẳng bằng nhau"
   },
   {
    "lines": [
     "Vì {{22}} $\\in$ {{23}} và {{20}} = {{21}} nên {{22}} là trung điểm của {{23}}."
    ],
    "hint": "Kết luận trung điểm"
   }
