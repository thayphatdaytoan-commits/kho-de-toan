 "6b": {
  "blocks": [
   {
    "lines": [
     "Xét $\\triangle$ {{1}} và $\\triangle$ {{2}} có:",
     "$\\widehat{OHE} = \\widehat{OCM} = 90^0$",
     "$\\widehat{HOE} = \\widehat{COM}$ ({{3}})."
    ],
    "hint": "Xét cặp tam giác đồng dạng thứ nhất"
   },
   {
    "lines": [
     "Suy ra $\\triangle$ {{4}} $\\sim$ $\\triangle$ {{5}} ({{6}}),",
     "do đó $\\frac{OH}{OC} = \\frac{OE}{OM} \\Rightarrow OC \\cdot OE = OH \\cdot OM$ (1)."
    ],
    "hint": "Kết luận đồng dạng và hệ thức"
   },
   {
    "lines": [
     "Xét $\\triangle$ {{7}} và $\\triangle$ {{8}} có:",
     "$\\widehat{OHA} = \\widehat{OAM} = 90^0$",
     "$\\widehat{HOA} = \\widehat{AOM}$ ({{9}})."
    ],
    "hint": "Xét cặp tam giác đồng dạng thứ hai"
   },
   {
    "lines": [
     "Suy ra $\\triangle$ {{10}} $\\sim$ $\\triangle$ {{11}} ({{12}}),",
     "do đó $\\frac{OH}{OA} = \\frac{OA}{OM} \\Rightarrow OH \\cdot OM = OA^2$ (2)."
    ],
    "hint": "Kết luận đồng dạng và hệ thức"
   },
   {
    "lines": [
     "Từ (1) và (2) suy ra {{13}} = {{14}}."
    ],
    "hint": "Kết luận cuối cùng"
   }
  ],
