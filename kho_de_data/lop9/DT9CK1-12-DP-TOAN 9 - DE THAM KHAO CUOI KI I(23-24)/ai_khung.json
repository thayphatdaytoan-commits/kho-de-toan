   {
    "lines": [
     "Ta có: $\\sin$ {{5}} = $\\cos$ {{6}} = $\\cos$ {{7}} = $\\frac{{{8}}}{{{9}}}$",
     "Suy ra ${{8}}$ = {{9}}.$\\sin$ {{5}}"
    ],
    "hint": "Biến đổi tỉ số lượng giác"
   },
   {
    "lines": [
     "Ta có: $\\cos$ {{10}} = $\\frac{{{11}}}{{{12}}}$",
     "Suy ra ${{11}}$ = {{12}}.$\\cos$ {{10}}"
    ],
    "hint": "Biến đổi tỉ số lượng giác thứ hai"
   },
   {
    "lines": [
     "Mà $AC^2$ = ${{8}}$.${{11}}$ = {{9}}.$\\sin$ {{5}}.{{12}}.$\\cos$ {{10}}",
     "$AC^2$ = {{13}}.$DM$.$\\sin$ {{5}}.$\\cos$ {{10}}"
    ],
    "hint": "Thay thế vào đẳng thức"
